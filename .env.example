# GEMINI_API_KEY: Required for Gemini AI forensic explanations & AI Fraud Intelligence Assistant.
# Configure via Secrets panel in AI Studio or .env locally.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign credential-based operator sessions (auto-generated in dev if unset).
JWT_SECRET="CHANGE_ME_STRONG_RANDOM_SECRET"

# PostgreSQL / Cloud SQL Runtime Variables (provided automatically in Cloud SQL environment)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="resq_ai"
SQL_USER="resq_app"
SQL_PASSWORD="CHANGE_ME"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="CHANGE_ME"

# Optional Notification Providers (Leave unset to use safe simulated delivery in demo mode)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Optional Payment Gateway Sandbox (Leave unset to use built-in Simulated Payment Engine)
STRIPE_SECRET_KEY=""
